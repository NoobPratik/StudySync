# StudySync production environment (copy to .env, never commit the copy).
# Root homelab .env supplies TAILSCALE_IP when deployed with `make up STACK=studysync`;
# the compose file falls back to the Pi's Tailscale IP for direct `docker compose` use.

# Database — POSTGRES_PASSWORD is required; compose fails fast if it is missing.
POSTGRES_USER=studysync
POSTGRES_PASSWORD=
POSTGRES_DB=studysync
DATABASE_URL=postgresql://studysync:CHANGE_ME@postgres:5432/studysync?schema=public

# Auth / public URL (must match the Cloudflare hostname)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=https://study.pratik2296.dev
TRUSTED_ORIGINS=https://study.pratik2296.dev

# Uploads inside the container; bind mount is /mnt/drive/studysync/uploads
UPLOAD_DIR=/app/uploads

# Optional Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Web push (VAPID) — subject should be a mailto: or https: origin you control
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@studysync.local
